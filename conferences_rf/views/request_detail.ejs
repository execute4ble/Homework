<%- include('header') %>

<div class="container my-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h2 mb-0">Заявка №<%= request.id %></h1>
    <a href="<%= isAdmin ? '/admin' : '/dashboard' %>" class="btn btn-outline-secondary">
      &larr; Назад к заявкам
    </a>
  </div>

  <div class="row g-4">
    <!-- Основная информация о заявке и помещении (Доступно всем) -->
    <div class="col-md-7 col-12">
      <div class="card shadow-sm mb-4">
        <div class="card-header bg-light d-flex justify-content-between align-items-center">
          <h5 class="mb-0">Детали мероприятия</h5>
          <span class="badge bg-<%= request.status === 'Новая' ? 'secondary' : (request.status === 'Мероприятие назначено' ? 'primary' : 'success') %>">
            <%= request.status %>
          </span>
        </div>
        <div class="card-body">
          <p class="mb-2"><b>Дата проведения:</b> <%= request.date_start %></p>
          <p class="mb-3"><b>Способ оплаты:</b> <%= request.payment %></p>
          
          <hr>
          
          <h6 class="text-muted text-uppercase small tracking-wider mb-3">Информация о помещении</h6>
          <p class="mb-2"><b>Название:</b> <%= request.room_name %></p>
          <p class="mb-2"><b>Тип:</b> <%= request.room_type %></p>
          <p class="mb-0"><b>Вместимость:</b> <%= request.room_capacity %> чел.</p>
        </div>
      </div>

      <!-- Блок отзыва (Доступно всем, если отзыв оставлен) -->
      <% if (request.review) { %>
        <div class="card border-success shadow-sm mb-4">
          <div class="card-header bg-success text-white">
            <h5 class="mb-0">Отзыв о качестве мероприятия</h5>
          </div>
          <div class="card-body">
            <p class="card-text text-dark italic font-monospace">"<%= request.review %>"</p>
          </div>
        </div>
      <% } %>

      <!-- Форма добавления отзыва (Только владельцу, при статусе 'Завершено' и если отзыва еще нет) -->
      <% if (isOwner && request.status === 'Завершено' && !request.review) { %>
        <div class="card border-primary shadow-sm mb-4">
          <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Оставить отзыв</h5>
          </div>
          <div class="card-body">
            <form method="POST" action="/review/<%= request.id %>">
              <div class="mb-3">
                <label for="reviewText" class="form-label">Поделитесь вашими впечатлениями о проведенном мероприятии:</label>
                <textarea class="form-control" id="reviewText" name="review" rows="4" placeholder="Напишите ваш отзыв здесь..." required></textarea>
              </div>
              <button type="submit" class="btn btn-primary w-100">Отправить отзыв</button>
            </form>
          </div>
        </div>
      <% } %>
    </div>

    <!-- Информация о пользователе (Отображается ТОЛЬКО администратору) -->
    <% if (isAdmin) { %>
      <div class="col-md-5 col-12">
        <div class="card border-warning shadow-sm">
          <div class="card-header bg-warning text-dark">
            <h5 class="mb-0">Данные заявителя (Админ-панель)</h5>
          </div>
          <div class="card-body">
            <p class="mb-2"><b>ФИО:</b> <%= request.user_fio %></p>
            <p class="mb-2"><b>Логин:</b> <%= request.user_login %></p>
            <p class="mb-2"><b>Email:</b> <a href="mailto:<%= request.user_email %>"><%= request.user_email %></a></p>
            <p class="mb-0"><b>Телефон:</b> <%= request.user_phone %></p>
          </div>
        </div>
      </div>
    <% } %>
  </div>
</div>

<%- include('footer') %>
