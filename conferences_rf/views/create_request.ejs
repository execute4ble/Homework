<%- include('header') %>
<div class="row justify-content-center">
  <div class="col-md-8 col-12">
    <h1 class="mb-4">Новая заявка</h1>
    
    <% if(typeof errors !== 'undefined' && errors.length) { %>
      <div class="alert alert-danger">
        <% errors.forEach( e => { %>
          <div><%= e %></div>
        <% }) %>
      </div>
    <% } %>

    <form method="POST" action="/create">
      <div class="mb-3">
        <label class="form-label">Помещение</label>
        <select name="room_id" class="form-select" required>
          <option value="" disabled selected>Выберите помещение</option>
          <% rooms.forEach( r => { %>
            <option value="<%= r.id %>"><%= r.type %> - <%= r.name %> (<%= r.capacity %> чел.)</option>
          <% }) %>
        </select>
      </div>

      <div class="mb-3">
        <label class="form-label">Дата начала конференции</label>
        <input type="date" class="form-control" name="date_start" required>
      </div>

      <div class="mb-3">
        <label class="form-label">Способ оплаты</label>
        <select name="payment" class="form-select" required>
          <option value="" disabled selected>Выберите способ оплаты</option>
          <option value="При очном посещении">При очном посещении</option>
          <option value="Перевод по СБП">Перевод по СБП</option>
        </select>
      </div>

      <button class="btn btn-primary w-100">Отправить</button>
    </form>

    <p class="mt-3 text-center">
      <a href="/dashboard">Вернуться к моим заявкам</a>
    </p>
  </div>
</div>
<%- include('footer') %>
