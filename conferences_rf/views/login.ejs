<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Авторизация</title>
</head>
<body>
    <h2>Вход в систему</h2>
    <form method="POST" action="/login">
        <p><input name="login" placeholder="Логин" required></p>
